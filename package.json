{
  "name": "geoplan-web",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "lint": "eslint frontend/src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "check:architecture": "node --test scripts/check_frontend_architecture.test.mjs && node scripts/check_frontend_architecture.mjs",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "lucide-react": "^1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^27.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "8.0.13",
    "vitest": "^3.2.4"
  },
  "type": "module"
}
